#!/usr/bin/env bash
#MISE description="Build and format-check the host C++ library"
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
CPP_DIR="$ROOT_DIR/cpp-spoken-time"

find "$CPP_DIR/include" "$CPP_DIR/src" \
    -type f \( -name '*.cpp' -o -name '*.hpp' \) -print0 |
    xargs -0 clang-format --dry-run --Werror

cd "$CPP_DIR"
cmake --preset dev
cmake --build --preset dev --parallel
