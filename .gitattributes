* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.tsv text eol=lf
CMakeLists.txt text eol=lf
.mise/tasks/** text eol=lf
gradlew text eol=lf
