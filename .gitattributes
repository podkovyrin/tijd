# Release screenshots are binary assets stored in Git LFS.
android/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
android/fastlane/metadata/android/**/images/phoneScreenshots/*.png filter=lfs diff=lfs merge=lfs -text
